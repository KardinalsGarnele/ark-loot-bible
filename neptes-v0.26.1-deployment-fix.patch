+from pathlib import Path
+
+from fastapi.testclient import TestClient
+
+from ark_loot_bible.config import ROOT
+from ark_loot_bible.main import STATIC, app
+
+
+def test_resolved_root_contains_web_assets():
+    assert ROOT.is_dir()
+    assert STATIC == ROOT / "packages" / "web" / "static"
+    assert (STATIC / "index.html").is_file()
+
+
+def test_application_starts_and_serves_assets():
+    client = TestClient(app)
+    assert client.get("/health").status_code == 200
+    assert client.get("/").status_code == 200
+    assert client.get("/static/app.js").status_code == 200
