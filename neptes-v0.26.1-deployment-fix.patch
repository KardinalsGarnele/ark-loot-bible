 from pathlib import Path
 import os
 
-ROOT = Path(__file__).resolve().parents[3]
+
+def _resolve_root() -> Path:
+    """Resolve the repository/application root in source and installed builds.
+
+    Docker installs the Python package into site-packages, so deriving the root
+    only from ``__file__`` points at ``/usr/local/lib`` instead of ``/app``.
+    Prefer an explicit environment variable, then the current working directory,
+    and finally walk upwards from this file for a source checkout.
+    """
+    configured = os.getenv("ARK_LOOT_BIBLE_ROOT")
+    if configured:
+        return Path(configured).expanduser().resolve()
+
+    candidates = [Path.cwd(), *Path(__file__).resolve().parents]
+    for candidate in candidates:
+        if (candidate / "packages" / "web" / "static").is_dir():
+            return candidate
+
+    # Keep a deterministic fallback for diagnostics. main.py will raise a clear
+    # error if the expected web assets are not present here.
+    return Path.cwd().resolve()
+
+
+ROOT = _resolve_root()
+
 
